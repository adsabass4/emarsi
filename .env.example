# ===== Telegram =====
# Bot token from @BotFather (e.g. 123456789:AAE...). Leave empty to disable alerts.
TELEGRAM_BOT_TOKEN=
# Chat ID to receive alerts (user/group/channel). Get it from @userinfobot or via getUpdates.
TELEGRAM_CHAT_ID=

# ===== Database (Turso) =====
# Cloud SQLite (Turso) URL, e.g. libsql://emarsi-db-yourname.turso.io or https://...
# Leave EMPTY to fall back to the local SQLite file (data/scanner.db).
TURSO_DATABASE_URL=
# Auth token from `turso db tokens create <db-name>`.
# Required when TURSO_DATABASE_URL is set; leave empty otherwise.
TURSO_AUTH_TOKEN=

# ===== Scheduling =====
# Full scan cycle interval in minutes (default 15)
SCAN_INTERVAL_MINUTES=15
# Optional: override with a raw cron expression (e.g. "*/10 * * * *"). Takes priority over SCAN_INTERVAL_MINUTES.
# Leave empty to use interval.
SCAN_CRON=

# Watchdog: if a scan cycle runs longer than this (minutes), the scheduler
# force-releases its lock so the next scheduled tick starts a fresh cycle
# instead of skipping forever. 0 = auto (max(scan interval, 25 min)).
CYCLE_TIMEOUT_MINUTES=0
# Marks the dashboard/API as "stale" when the last successful scan is older
# than this many multiples of SCAN_INTERVAL_MINUTES (default 1.5).
STALE_FACTOR=1.5

# ===== Strategy (EMA crossover) =====
EMA_FAST=9
EMA_SLOW=21
RSI_MIN=45
RSI_MAX=65
# RSI period (Wilder's smoothing)
RSI_PERIOD=14
# Volume condition: last candle volume > SMA of last N candles
VOLUME_SMA=20

# ===== OKX data =====
# Timeframes scanned every cycle, comma-separated (e.g. 1H,4H,1D).
# Set a single value to disable the others.
TIMEFRAMES=1H,4H
# Which timeframe is initially selected in the dashboard (must be in TIMEFRAMES).
TIMEFRAME=4H
# Number of candles to fetch per symbol per timeframe (max 300)
CANDLES_LIMIT=120
# Liquidity filter: symbols with 24h USD volume (volCcy24h) below this value are
# skipped BEFORE any candle request, so small pairs never waste API calls.
# Set to 0 to disable the filter.
MIN_VOLUME_USD_24H=300000
# Resolution of the series used to compute the dashboard's "change over period"
# column (options: 5m, 15m, 1h live windows = 5m/15m/1h/4h). Default 5m.
CHANGE_BAR=5m
# OKX public base URL (change only for mirrors/proxies)
OKX_BASE_URL=https://www.okx.com/api/v5

# ===== Performance / rate limiting =====
# Max concurrent candle requests (OKX limit is ~20 req / 2s per IP)
CONCURRENCY=6
# Max requests started per 2 seconds (kept below OKX limit for safety)
REQUESTS_PER_2S=16
# Request timeout (ms)
REQUEST_TIMEOUT_MS=10000

# ===== Storage =====
# Keep scan history rows for N days, then prune old rows
RETENTION_DAYS=30

# ===== Web server =====
PORT=3000
# Server timezone used by node-cron/logs (e.g. Asia/Riyadh)
TZ=UTC

# ===== Testing =====
# Set to true to log "would alert" instead of actually sending to Telegram
# (also runs the dedup logic, no real messages are sent).
DRY_RUN=false